#!/bin/sh /etc/rc.common
# Copyright (C) 2026 Dengfeng Liu
# chawrt-bpf-dispatcher service - manages eBPF TC pipeline initialization and health check

START=89
STOP=10
USE_PROCD=1
NAME=chawrt-bpf-dispatcher

start_service() {
	config_load chawrt-bpf-dispatcher
	local enabled ifname
	config_get_bool enabled global enabled 1
	config_get ifname global ifname "br-lan"

	[ "$enabled" -eq 1 ] || return 0
	[ -e "/sys/class/net/$ifname" ] || return 0

	# Ensure clsact qdisc exists on LAN bridge
	tc qdisc add dev "$ifname" clsact 2>/dev/null || true

	echo "chawrt-bpf-dispatcher initialized clsact on $ifname"
}

stop_service() {
	return 0
}
